# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth2 Settings
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-oauth-client-id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-oauth-client-secret
SOCIAL_AUTH_LOGIN_REDIRECT_URL=http://localhost:3000/
SOCIAL_AUTH_LOGIN_ERROR_URL=http://localhost:3000/

# Database Settings
# Opção 1: Neon Database (recomendado - use a connection string completa)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Opção 2: PostgreSQL tradicional (variáveis individuais)
# DB_NAME=ai_email_sorter
# DB_USER=postgres_user
# DB_PASSWORD=postgres_password
# DB_HOST=localhost
# DB_PORT=5432

# Se nenhuma das opções acima estiver configurada, o sistema usará SQLite (desenvolvimento)

# Redis Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0

# Google Cloud Settings
GCLOUD_PROJECT=your-gcloud-project-id
PUBSUB_SUBSCRIPTION_ID=your-pubsub-subscription-id
GMAIL_PUBSUB_TOPIC=your-gmail-pubsub-topic

# Hugging Face API Settings (optional but recommended for better performance)
# Get your token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=your-huggingface-api-token


